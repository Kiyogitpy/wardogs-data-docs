  "usmap_wdextract": "E:/Reverse_Engineer/wardogs_analysis/round8_propertybags_20261019/normal-order.usmap",
  "wdextract_exe": "E:/Reverse_Engineer/wardogs_analysis/round76_icons/bin/WdExtract.exe",
