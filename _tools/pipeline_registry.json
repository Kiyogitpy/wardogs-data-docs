 },
 "config_keep": {
  "_comment": "Raw files copied from the paks into data/ next to the CueDump JSON (the curated set the generators read). DefaultGame.ini is never copied: its whitelisted excerpt is written by default_game_ini.py. Config files in the paks that are not listed here are reported as 'new, not copied'.",
  "files": [
   "Wardogs/Config/DefaultGameplayTags.ini",
   "Wardogs/Config/DefaultMatchState.ini",
   "Wardogs/Plugins/GameFeatures/ControlZone/Config/DefaultControlZone.ini",
   "Wardogs/Plugins/GameFeatures/PvE/Scenarios/BaseScenario/Config/DefaultBaseScenario.ini",
   "Wardogs/Plugins/GameFeatures/Vehicles/VehicleUtility/Config/DefaultVehicleUtility.ini",
   "Wardogs/Plugins/GameFeatures/Deathmatch/Deathmatch.uplugin",
   "Wardogs/Plugins/GameFeatures/HotPotato/HotPotato.uplugin",
   "Wardogs/Plugins/GameFeatures/ServerSeeding/ServerSeeding.uplugin"
  ],
  "trees": [
   "Wardogs/Config/ServerConfigs/",
   "Wardogs/Config/Tags/",
   "Wardogs/Config/Experiences/"
  ],
  "exclude": [
   "Wardogs/Config/Experiences/Bundles/"
  ]
 },
 "passes": [
  {
   "name": "files",
   "tier": "core",
   "wdextract": [
    "list",
    ""
   ],
   "produces": "files/files.txt",
   "note": "every package path in the paks; input of the icons pass and of the model chain"
  },
  {
   "name": "ge",
   "tier": "core",
   "wdextract": [
    "list",
    "GE_"
   ],
   "then": "dump",
   "summary": "tools/cue4parse_extractor/ge_summary.py",
   "copy_to": "assets/data/ge-values.json",
   "note": "341 GE_* effects: list, dump, ge_summary.py -> ge-values.json (reproduces the committed file byte for byte)"
  },
  {
   "name": "icons",
   "tier": "assets",
   "note": "item_icons.py list -> WdExtract textures -> item_icons.py build (PNG into assets/img/icons, item-icons.json)"
  }
 ],
 "chains": [
  {
   "name": "models",
   "enabled": false,
   "note": "Branch r86-mdl is on main (docs/evidence/round86-models.md, section Regenerate). The pipeline does not run this chain: it needs a per-vehicle mesh cycle and Node.js (npx glTF-Transform). `X` = WdExtract <Paks> <key> normal-order.usmap <out> <oo2core>. Run the steps by hand in a regen worktree after `regen` (data/ must point at the new export).",
   "steps": [
    "X all list \"\"",
    "python -I _tools/object_models.py --plan plan --files all/files.txt",
    "X col2 collision plan/collision_in.txt",
    "X phys physics plan/phys_in.txt --names normal-order.usmap",
    "python -I _tools/object_models.py --collision col2/collision.json --physics phys/physics.json",
    "python -I _tools/object_models.py --check",
    "python -I _tools/object_models_check.py",
    "python -I tools/cue4parse_extractor/vehicle_meshes.py plan . all/files.txt vv <vehicle-id>",
    "X vv/<vehicle-id> mesh vv/<vehicle-id>/_inputs.txt --names normal-order.usmap",
    "python -I tools/cue4parse_extractor/vehicle_meshes.py finish . vv <vehicle-id>",
    "python -I _tools/vehicle_models.py --meshes vv <vehicle-id>",
    "python -I _tools/damage_tables.py --json"
   ]
  }
 ],
