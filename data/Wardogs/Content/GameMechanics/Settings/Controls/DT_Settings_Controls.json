        "Description": {
          "TableId": "/Game/UI/StringTables/STRINGS_Settings_Controls.STRINGS_Settings_Controls",
          "Key": "Description.FovSensitivityScalingTransitionType",
          "SourceString": "While Transitioning - Aiming sens scaling will always be fully applied if you are currently in the ads transition.\r\n\r\nAds Transition - Aiming sens scaling will be applied relative to your ads transition. This will feel most natural.\r\n\r\nTransition Finished - Aiming sens scaling will only be applied when the ads transition has completely finished and you are ads.\r\n\r\nInstant - Aiming sens scaling will be fully applied when you are attempting to ads, so from the moment you hold / toggle ads.",
          "LocalizedString": "While Transitioning - Aiming sens scaling will always be fully applied if you are currently in the ads transition.\r\n\r\nAds Transition - Aiming sens scaling will be applied relative to your ads transition. This will feel most natural.\r\n\r\nTransition Finished - Aiming sens scaling will only be applied when the ads transition has completely finished and you are ads.\r\n\r\nInstant - Aiming sens scaling will be fully applied when you are attempting to ads, so from the moment you hold / toggle ads."
        },
        "_aaabgfhfjeijiknfodnof_$57594898AD5E3DE5$_$22$": false,
