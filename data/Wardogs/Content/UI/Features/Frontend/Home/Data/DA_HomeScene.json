          "Title": {
            "TableId": "/Game/UI/StringTables/STRINGS_Popups.STRINGS_Popups",
            "Key": "Title.PatchNotes",
            "SourceString": "EARLY ACCESS",
            "LocalizedString": "EARLY ACCESS"
          },
          "Subtitle": {
            "TableId": "/Game/UI/StringTables/STRINGS_Popups.STRINGS_Popups",
            "Key": "Subtitle.PatchNotes",
            "SourceString": "WARDOGS Early Access",
            "LocalizedString": "WARDOGS Early Access"
          },
          "Description": {
            "TableId": "/Game/UI/StringTables/STRINGS_Popups.STRINGS_Popups",
            "Key": "Description.PatchNotes",
            "SourceString": "// Welcome to WARDOGS\r\nThank you for purchasing our game.\r\n\r\nWelcome to Early Access Season 02. This update brings a new weather variant 'rain' as well as new weapons, vehicles, attachments and buildables, alongside a brand new vendor and balance changes to shake up the metagame. Season 01 XP & Cash progression has been reset. Any cash you had remaining at the end of the season 01 has been automatically converted into gold bars, which you can use to unlock permanent cosmetics for your account in the gold market. All XP and tracked stats have been banked into our backend for use with future in game systems once implemented.\r\n\r\nAs a reminder - WARDOGS is an early access game. If you haven't watched our '10 Reasons NOT to buy WARDOGS' video, we highly recommend you do to understand that this is a long road to 1.0 release. This is a sandbox that rewards teamplay, creativity and freedom, so make sure to use proximity chat for the best experience.\r\n\r\nIf you see any bugs or cheaters, please report them ingame via the scoreboard or use the appropriate bots in our Official Discord.\r\n\r\nThanks,\r\nBULKHEAD",
            "LocalizedString": "// Welcome to WARDOGS\r\nThank you for purchasing our game.\r\n\r\nWelcome to Early Access Season 02. This update brings a new weather variant 'rain' as well as new weapons, vehicles, attachments and buildables, alongside a brand new vendor and balance changes to shake up the metagame. Season 01 XP & Cash progression has been reset. Any cash you had remaining at the end of the season 01 has been automatically converted into gold bars, which you can use to unlock permanent cosmetics for your account in the gold market. All XP and tracked stats have been banked into our backend for use with future in game systems once implemented.\r\n\r\nAs a reminder - WARDOGS is an early access game. If you haven't watched our '10 Reasons NOT to buy WARDOGS' video, we highly recommend you do to understand that this is a long road to 1.0 release. This is a sandbox that rewards teamplay, creativity and freedom, so make sure to use proximity chat for the best experience.\r\n\r\nIf you see any bugs or cheaters, please report them ingame via the scoreboard or use the appropriate bots in our Official Discord.\r\n\r\nThanks,\r\nBULKHEAD"
          },
