      {
        "Key": {
          "TagName": "UI.Popup.PatchNotes"
        },
        "Value": {
          "Tag": {
            "TagName": "UI.Popup.PatchNotes"
          },
          "Type": {
            "TagName": "UI.Popup.Type.Custom.PatchNotes"
          },
          "Title": {
            "TableId": "/Game/UI/StringTables/STRINGS_Popups.STRINGS_Popups",
            "Key": "Title.PatchNotes",
            "SourceString": "EARLY ACCESS",
            "LocalizedString": "EARLY ACCESS"
          },
          "Subtitle": {
            "TableId": "/Game/UI/StringTables/STRINGS_Popups.STRINGS_Popups",
            "Key": "Subtitle.PatchNotes",
            "SourceString": "WARDOGS Early Access",
            "LocalizedString": "WARDOGS Early Access"
          },
          "Description": {
            "TableId": "/Game/UI/StringTables/STRINGS_Popups.STRINGS_Popups",
            "Key": "Description.PatchNotes",
            "SourceString": "// Welcome to WARDOGS\r\n\r\nWelcome to Early Access Season 03. This update brings a new map 'Sabatulo' with a mix of urban firefights, close quarters combat and verticality. This comes in tandem with an optional \"Limited Mode\" that simulates early-mid game progression and is available throughout the entire season.\r\n\r\nWe are also introducing a catchup mechanic specifically for low level players that applies a small catchup XP bonus (per role) that increases throughout the season, so more players have the opportunity to obtain midgame items & endgame counters. Other balance changes, bug fixes and updates can be read in the latest patch notes.\r\n\r\nSeasonal XP & Cash earnings have been reset. Any cash you had remaining at the end of the last season has been automatically converted into gold bars, which you can use to unlock permanent cosmetics for your account in the gold market. All XP and tracked stats have been banked into our backend for use with future in game systems once implemented.\r\n\r\nAs a reminder - WARDOGS is an early access game. If you haven't watched our '10 Reasons NOT to buy WARDOGS' video, we highly recommend you do to understand that this is a long road to 1.0 release. This is a sandbox that rewards teamplay, creativity and freedom, so make sure to use proximity chat for the best experience.\r\n\r\nThanks,\r\nBULKHEAD",
            "LocalizedString": "// Welcome to WARDOGS\r\n\r\nWelcome to Early Access Season 03. This update brings a new map 'Sabatulo' with a mix of urban firefights, close quarters combat and verticality. This comes in tandem with an optional \"Limited Mode\" that simulates early-mid game progression and is available throughout the entire season.\r\n\r\nWe are also introducing a catchup mechanic specifically for low level players that applies a small catchup XP bonus (per role) that increases throughout the season, so more players have the opportunity to obtain midgame items & endgame counters. Other balance changes, bug fixes and updates can be read in the latest patch notes.\r\n\r\nSeasonal XP & Cash earnings have been reset. Any cash you had remaining at the end of the last season has been automatically converted into gold bars, which you can use to unlock permanent cosmetics for your account in the gold market. All XP and tracked stats have been banked into our backend for use with future in game systems once implemented.\r\n\r\nAs a reminder - WARDOGS is an early access game. If you haven't watched our '10 Reasons NOT to buy WARDOGS' video, we highly recommend you do to understand that this is a long road to 1.0 release. This is a sandbox that rewards teamplay, creativity and freedom, so make sure to use proximity chat for the best experience.\r\n\r\nThanks,\r\nBULKHEAD"
          },
