            "Key": "Vendor.Garage.SupplyCrateInfo.Pallets.Title",
            "SourceString": "SUPPLY PALLETS",
            "LocalizedString": "SUPPLY PALLETS"
          },
          "_aaaafknmiilikmomkcepg_$ADC88B8ACECA24F6$_$5$": {
            "TableId": "/Game/UI/StringTables/STRINGS_Vendor.STRINGS_Vendor",
            "Key": "Vendor.Garage.SupplyCrateInfo.Pallets.Badge",
            "SourceString": "SUPPLY PALLETS ALLOW YOU TO DELIVER SUPPLIES TO FOBS",
            "LocalizedString": "SUPPLY PALLETS ALLOW YOU TO DELIVER SUPPLIES TO FOBS"
          },
          "Body": {
            "TableId": "/Game/UI/StringTables/STRINGS_Vendor.STRINGS_Vendor",
            "Key": "Vendor.Garage.SupplyCrateInfo.Pallets.Body",
            "SourceString": "1. PURCHASE A SUPPLY PALLET (NO REFUNDS!).\r\n2. THE PALLET IS LOADED INTO YOUR VEHICLE'S LOGISTICS SLOTS.\r\n3. DRIVE YOUR VEHICLE CLOSE TO A FRIENDLY FOB.\r\n4. OPEN VEHICLE INTERACTION MENU.\r\n5. DEPLOY THE SUPPLY PALLET.\r\n6. ANYONE CAN UNLOAD THE SUPPLIES INTO THE FOB INVENTORY.\r\n7. THE FOB USES SUPPLIES TO BUILD, REARM AND REPAIR.\r\n8. BOTH THE DRIVER AND THE UNLOADER EARN CASH.",
            "LocalizedString": "1. PURCHASE A SUPPLY PALLET (NO REFUNDS!).\r\n2. THE PALLET IS LOADED INTO YOUR VEHICLE'S LOGISTICS SLOTS.\r\n3. DRIVE YOUR VEHICLE CLOSE TO A FRIENDLY FOB.\r\n4. OPEN VEHICLE INTERACTION MENU.\r\n5. DEPLOY THE SUPPLY PALLET.\r\n6. ANYONE CAN UNLOAD THE SUPPLIES INTO THE FOB INVENTORY.\r\n7. THE FOB USES SUPPLIES TO BUILD, REARM AND REPAIR.\r\n8. BOTH THE DRIVER AND THE UNLOADER EARN CASH."
          }
        }
      }
