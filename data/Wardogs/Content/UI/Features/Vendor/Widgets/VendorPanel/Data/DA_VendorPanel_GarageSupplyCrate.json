            "SourceString": "SUPPLY CRATES",
            "LocalizedString": "SUPPLY CRATES"
          },
          "_aaaafknmiilikmomkcepg_$ADC88B8ACECA24F6$_$5$": {
            "TableId": "/Game/UI/StringTables/STRINGS_Vendor.STRINGS_Vendor",
            "Key": "Vendor.Garage.SupplyCrateInfo.Crates.Badge",
            "SourceString": "SUPPLY CRATES ALLOW YOU TO SELL ITEMS TO OTHER PLAYERS",
            "LocalizedString": "SUPPLY CRATES ALLOW YOU TO SELL ITEMS TO OTHER PLAYERS"
          },
          "Body": {
            "TableId": "/Game/UI/StringTables/STRINGS_Vendor.STRINGS_Vendor",
            "Key": "Vendor.Garage.SupplyCrateInfo.Crates.Body",
            "SourceString": "1. PURCHASE A SUPPLY CRATE (NO REFUNDS!).\r\n2. BUY DESIRABLE ITEMS INTO THE CRATE TO SELL.\r\n3. CONFIRM YOUR MARKUP % BEFORE LEAVING THE SAFE ZONE.\r\n4. DRIVE YOUR VEHICLE TO THE CONTROL ZONE.\r\n5. OPEN VEHICLE INTERACTION MENU.\r\n6. DEPLOY THE SUPPLY CRATE.\r\n7. TEAMMATES CAN NOW BUY YOUR ITEMS IN THE ZONE.\r\n8. MAKE PROFIT.",
            "LocalizedString": "1. PURCHASE A SUPPLY CRATE (NO REFUNDS!).\r\n2. BUY DESIRABLE ITEMS INTO THE CRATE TO SELL.\r\n3. CONFIRM YOUR MARKUP % BEFORE LEAVING THE SAFE ZONE.\r\n4. DRIVE YOUR VEHICLE TO THE CONTROL ZONE.\r\n5. OPEN VEHICLE INTERACTION MENU.\r\n6. DEPLOY THE SUPPLY CRATE.\r\n7. TEAMMATES CAN NOW BUY YOUR ITEMS IN THE ZONE.\r\n8. MAKE PROFIT."
          }
        }
      },
