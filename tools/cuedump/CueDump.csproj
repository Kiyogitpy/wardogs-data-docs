<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Path to a CUE4Parse checkout (FabianFG/CUE4Parse at 0415fe2 is known to work). Override with -p:CUE4ParseProject=... -->
    <CUE4ParseProject Condition="'$(CUE4ParseProject)' == ''">..\..\..\CUE4Parse\CUE4Parse\CUE4Parse.csproj</CUE4ParseProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CUE4ParseProject)" />
  </ItemGroup>
</Project>
